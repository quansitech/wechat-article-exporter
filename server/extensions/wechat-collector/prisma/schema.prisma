// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. 系统配置表 (存储 Cookie/Token)
model SystemConfig {
  key   String @id
  value String

  @@map("system_config")
}

// 2. 公众号表
model Account {
  id             String    @id // fakeid / biz
  name           String
  entityName     String?   @map("entity_name") // 搜索主体

  isVerified     Boolean   @default(false) @map("is_verified")
  lastCrawlTime  DateTime? @map("last_crawl_time") // 增量抓取锚点

  extra          String? // 存储 JSON 字符串 (intro, etc.)

  articles       Article[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

// 3. 文章表
model Article {
  id          String   @id // URL Hash
  url         String   @unique
  title       String
  digest      String?
  accountId   String   @map("account_id")
  account     Account  @relation(fields: [accountId], references: [id])

  publishTime BigInt?  @map("publish_time")

  // 状态: PENDING, PROCESSING, DONE, FAILED
  status      String   @default("PENDING")
  retryCount  Int      @default(0) @map("retry_count")
  lastError   String?  @map("last_error")
  failedAt    DateTime? @map("failed_at")

  content     String?
  extra       String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([accountId])
  @@index([status])
  @@map("article")
}

// 4. 采集任务表 (用于持久化任务状态)
model CollectionTask {
  id          String   @id
  subjectName String   @map("subject_name")
  status      String // pending, running, completed, failed
  progress    String // JSON string: { step, percentage, accountsDiscovered, articlesCollected, articlesProcessed, message }
  error       String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("collection_task")
}

// 5. 监控目标表
model MonitorTarget {
  id                  String     @id
  subjectName         String     @map("subject_name")
  checkIntervalMinutes Int       @default(720) @map("check_interval_minutes")
  webhookUrl          String?    @map("webhook_url")
  enabled             Boolean    @default(true)
  lastRunAt           DateTime?  @map("last_run_at")
  nextRunAt           DateTime?  @map("next_run_at")
  lastCrawlTime       DateTime?  @map("last_crawl_time")

  crawlRuns           CrawlRun[]

  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@map("monitor_target")
}

// 6. 爬取运行记录表
model CrawlRun {
  id              String        @id
  targetId        String        @map("target_id")
  target          MonitorTarget @relation(fields: [targetId], references: [id])
  triggerType     String        @default("manual") @map("trigger_type")
  status          String        @default("RUNNING") // RUNNING, COMPLETED, FAILED

  accountsChecked Int           @default(0) @map("accounts_checked")
  articlesNew     Int           @default(0) @map("articles_new")
  articlesFailed  Int           @default(0) @map("articles_failed")
  error           String?

  startedAt       DateTime      @default(now()) @map("started_at")
  completedAt     DateTime?     @map("completed_at")

  @@index([targetId, startedAt])
  @@map("crawl_run")
}
